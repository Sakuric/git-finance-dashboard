# ==============================================
# 金融投资平台 - 生产环境配置
# ==============================================
# 请根据您的实际情况修改以下配置

# ============== 数据库配置 ==============
MYSQL_ROOT_PASSWORD=YourStrongRootPassword@2025
MYSQL_DATABASE=finance_db
MYSQL_USER=finance_user
MYSQL_PASSWORD=YourStrongUserPassword@2025

# ============== 应用配置 ==============
# JWT密钥（至少256位，请务必修改）
JWT_SECRET=YourVeryLongAndSecureJWTSecretKeyHerePleaseChangeItInProduction2025AtLeast256Bits

# ============== LLM配置 ==============
# 您的AI模型API密钥（必须填写）
LLM_API_KEY=your_actual_llm_api_key_here

# LLM服务地址
LLM_BASE_URL=https://apis.iflow.cn/v1

# 使用的模型名称
LLM_MODEL=qwen3-vl-plus

# ============== 端口配置 ==============
# HTTP端口（建议使用80，如果80被占用可改为8888）
HTTP_PORT=80

# 后端端口（内部端口，不需要修改）
BACKEND_PORT=8081

# MySQL端口（如果服务器已有MySQL，请改为其他端口如13306）
MYSQL_PORT=3306
